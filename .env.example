# Carbon Pilot Environment Configuration Example
# Do not store sensitive secrets or credentials in this file.

# Server Configuration
PORT=8000
NODE_ENV=development
LOG_LEVEL=info

# Operating Mode: 'simulation' or 'kubernetes'
OPERATING_MODE=simulation

# Grid Carbon Intensity Provider: 'electricity-maps', 'watttime', or 'synthetic'
CARBON_SIGNAL_PROVIDER=electricity-maps
DEFAULT_GRID_ZONE=US-VA
CARBON_SIGNAL_CACHE_TTL_SECONDS=60

# Telemetry Source: 'prometheus' or 'synthetic'
TELEMETRY_SOURCE=prometheus
PROMETHEUS_ENDPOINT=http://prometheus-k8s.monitoring.svc.cluster.local:9090

# Target Cluster Namespace
TARGET_NAMESPACE=boutique
